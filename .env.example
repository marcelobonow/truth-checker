# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Usuários atendidos, servidores com acesso total, menções, modelo e esforço: edite src/settings.js

# Opcional: só analisa mensagens destes canais (IDs separados por vírgula). Vazio = todos.
WATCH_CHANNEL_IDS=

# Opcional: responde a todas as mensagens destes bots (IDs separados por vírgula).
RESPOND_TO_BOT_IDS=

# Captura mensagens em canais acompanhados (1/true ativa; 0/false desativa).
CONVERSATION_CAPTURE=true
# Habilita /analise-conversas; captura pode continuar ativa sem análise.
CONVERSATION_ANALYSIS=true
# Opcional: backend separado para a análise (claude, commandcode ou codex; padrão BACKEND).
CONVERSATION_ANALYSIS_BACKEND=
# Fuso usado para interpretar datas e horas do slash command.
CONVERSATION_TIME_ZONE=America/Sao_Paulo
# Timeout em ms por chamada de análise (padrão: CLAUDE_TIMEOUT_MS).
CONVERSATION_ANALYSIS_TIMEOUT_MS=

# Espera (ms) sem novas mensagens antes de processar o lote (padrão 7000)
BATCH_DELAY_MS=7000

# Diretório de trabalho nos servidores com acesso total (padrão: pasta do bot)
WORK_DIR=

# Instruções extras: prompt.<modo>.<backend>.md (ex.: prompt.web.commandcode.md), senão prompt.<modo>.md, senão prompt.md

# Qual CLI gera as respostas: BACKEND em src/settings.js ('claude' | 'commandcode' | 'codex')

# Executável do Claude Code (padrão: claude, resolvido pelo PATH)
CLAUDE_BIN=claude

# Command Code: só se a detecção pelo PATH falhar. Caminho do dist/index.mjs do
# pacote npm (ex.: C:\nvm4w\nodejs\node_modules\command-code\dist\index.mjs)
COMMANDCODE_BIN=

# Codex CLI (padrão: codex, resolvido pelo PATH)
CODEX_BIN=codex

# Tempo máximo por lote (qualquer backend), em ms (padrão: 600000 = 10 min)
CLAUDE_TIMEOUT_MS=600000

# Nível de log (trace, debug, info, warn, error). Console + logs/bot.log
LOG_LEVEL=info
