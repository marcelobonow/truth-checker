# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Usuários atendidos, servidores com acesso total, menções, modelo e esforço: edite src/settings.js

# Opcional: só analisa mensagens destes canais (IDs separados por vírgula). Vazio = todos.
WATCH_CHANNEL_IDS=

# Espera (ms) sem novas mensagens antes de processar o lote (padrão 7000)
BATCH_DELAY_MS=7000

# Diretório de trabalho do Claude nos servidores com acesso total (padrão: pasta do bot)
WORK_DIR=

# Instruções extras por modo: prompt.web.md e prompt.full.md na pasta do bot (fallback: prompt.md)

# Executável do Claude Code (padrão: claude, resolvido pelo PATH)
CLAUDE_BIN=claude

# Tempo máximo por lote, em ms (padrão: 600000 = 10 min)
CLAUDE_TIMEOUT_MS=600000

# Nível de log (trace, debug, info, warn, error). Console + logs/bot.log
LOG_LEVEL=info
